---
interface Props {
  locale?: 'en' | 'zh';
}

const { locale = 'en' } = Astro.props;
const about = locale === 'zh' ? '/zh/about' : '/about';
const privacy = locale === 'zh' ? '/zh/privacy' : '/privacy';
const rss = locale === 'zh' ? '/zh/rss.xml' : '/rss.xml';
const copyright = locale === 'zh'
  ? `© ${new Date().getFullYear()} DevPulse 保留所有权利`
  : `© ${new Date().getFullYear()} DevPulse. All rights reserved.`;
const aboutLabel = locale === 'zh' ? '关于' : 'About';
const privacyLabel = locale === 'zh' ? '隐私政策' : 'Privacy Policy';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p>{copyright}</p>
    <div class="footer-links">
      <a href={about}>{aboutLabel}</a>
      <a href={privacy}>{privacyLabel}</a>
      <a href={rss}>RSS</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--color-border);
    padding: 24px 0;
    margin-top: auto;
    color: var(--color-text-muted);
    font-size: 13px;
    background: rgba(10, 22, 40, 0.5);
    backdrop-filter: blur(10px);
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  .footer-links {
    display: flex;
    gap: 16px;
  }
  .footer-links a {
    color: var(--color-text-muted);
    transition: color var(--transition);
  }
  .footer-links a:hover {
    color: var(--color-accent);
  }
</style>
