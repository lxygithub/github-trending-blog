---
const client = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const slot = import.meta.env.PUBLIC_ADSENSE_SLOT;
const enabled = Boolean(client && slot);
---
{
  enabled && (
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={client}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    />
  )
}

{
  enabled && (
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={client}" crossorigin="anonymous" />
  )
}

{
  enabled && (
    <script>{(adsbygoogle = window.adsbygoogle || []).push({})}</script>
  )
}
