---
interface Props {
  locale?: 'en' | 'zh';
}

const { locale = 'en' } = Astro.props;
const pathname = Astro.url.pathname;
const switchHref = locale === 'zh'
  ? (pathname === '/zh/' ? '/' : pathname.replace(/^\/zh/, '') || '/')
  : (pathname === '/' ? '/zh/' : `/zh${pathname}`);
const home = locale === 'zh' ? '/zh/' : '/';
const about = locale === 'zh' ? '/zh/about' : '/about';
const privacy = locale === 'zh' ? '/zh/privacy' : '/privacy';
const rss = locale === 'zh' ? '/zh/rss.xml' : '/rss.xml';
const navHome = locale === 'zh' ? '首页' : 'Home';
const navAbout = locale === 'zh' ? '关于' : 'About';
const navPrivacy = locale === 'zh' ? '隐私' : 'Privacy';
const switchLabel = locale === 'zh' ? 'English' : '中文';
---
<header id="navbar">
  <nav class="nav-container">
    <a href={home} class="nav-brand">
      <img src="/logo.svg" class="nav-logo" alt="DevPulse" />
      <span class="nav-title">DevPulse</span>
    </a>
    <ul class="nav-links">
      <li><a href={home}>{navHome}</a></li>
      <li><a href={about}>{navAbout}</a></li>
      <li><a href={privacy}>{navPrivacy}</a></li>
      <li><a href={rss}>RSS</a></li>
      <li><a class="lang-switch" href={switchHref}>{switchLabel}</a></li>
      <li><button id="theme-toggle" type="button" aria-label="Toggle theme">🌙</button></li>
    </ul>
  </nav>
</header>

<style>
  #navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 14px 0;
    background: linear-gradient(180deg, rgba(10, 22, 40, 0.92), rgba(10, 22, 40, 0.72));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition: background var(--transition), backdrop-filter var(--transition), box-shadow var(--transition);
  }

  #navbar.scrolled {
    background: linear-gradient(180deg, rgba(10, 22, 40, 0.98), rgba(10, 22, 40, 0.88));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);
  }

  .nav-container {
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-white);
  }

  .nav-logo {
    width: 28px;
    height: 28px;
    filter: drop-shadow(0 0 8px var(--color-accent-glow));
  }

  .nav-title {
    font-size: 1.05rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-links a {
    color: var(--color-text);
    font-size: 0.95rem;
    position: relative;
    transition: color var(--transition);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width var(--transition);
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--color-white);
  }

  .nav-links a:hover::after,
  .nav-links a.active::after {
    width: 100%;
  }

  .lang-switch {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 13px !important;
  }

  .lang-switch::after {
    display: none;
  }

  #theme-toggle {
    border: 1px solid var(--color-border);
    background: var(--color-card-bg);
    color: var(--color-white);
    border-radius: 999px;
    width: 34px;
    height: 34px;
    cursor: pointer;
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  #theme-toggle:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent-glow);
  }

  @media (max-width: 640px) {
    .nav-title { font-size: 0.9rem; }
    .nav-links { gap: 12px; }
    .nav-links a { font-size: 0.82rem; }
  }
</style>

<script>
  function onScroll() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;
    navbar.classList.toggle('scrolled', window.scrollY > 10);
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', onScroll);
  onScroll();

  function initThemeToggle() {
    const themeBtn = document.getElementById('theme-toggle');
    const rootEl = document.documentElement;
    function updateThemeIcon() {
      if (!themeBtn) return;
      const dark = rootEl.getAttribute('data-theme') === 'dark';
      themeBtn.textContent = dark ? '☀️' : '🌙';
    }
    themeBtn?.addEventListener('click', () => {
      const next = rootEl.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      rootEl.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      updateThemeIcon();
    });
    updateThemeIcon();
  }
  document.addEventListener('astro:page-load', initThemeToggle);
  initThemeToggle();
</script>
