---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, repo } = post.data;
---
<article class="post-card">
  <h2 class="post-title">
    <a href={`/posts/${post.slug}/`}>{title}</a>
  </h2>
  {repo && <p class="post-repo">📦 {repo}</p>}
  <p class="post-desc">{description}</p>
  <div class="post-meta">
    <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('zh-CN')}</time>
    {tags.slice(0, 4).map((tag) => <span class="tag">#{tag}</span>)}
  </div>
</article>

<style>
  .post-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    background: var(--card);
    transition: border-color 0.2s;
  }
  .post-card:hover { border-color: var(--accent); }
  .post-title { margin: 0 0 8px; font-size: 20px; }
  .post-title a { color: var(--text); text-decoration: none; }
  .post-repo { margin: 0 0 8px; font-size: 13px; color: var(--accent); }
  .post-desc { margin: 0 0 12px; color: var(--muted); font-size: 14px; line-height: 1.6; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; font-size: 12px; color: var(--muted); }
  .tag { background: var(--tag-bg); padding: 2px 8px; border-radius: 999px; }
</style>
