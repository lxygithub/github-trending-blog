---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSense from '../components/AdSense.astro';
import ParticleCanvas from '../components/ParticleCanvas.astro';

interface Props {
  title: string;
  description?: string;
  locale?: 'en' | 'zh';
}

const { title, description, locale = 'en' } = Astro.props;
const siteTitle = locale === 'zh' ? 'DevPulse' : 'DevPulse';
const defaultDescription = locale === 'zh'
  ? '面向开发者的每日英文科技新闻'
  : 'Daily technology news for developers';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const htmlLang = locale === 'zh' ? 'zh-CN' : 'en';
---
<!doctype html>
<html lang={htmlLang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description || defaultDescription} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || defaultDescription} />
    <meta property="og:type" content="website" />
    <title>{title} | DevPulse</title>
    <ViewTransitions />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <ParticleCanvas />
    <Header locale={locale} />
    <main class="container">
      <slot />
    </main>
    <Footer locale={locale} />
    <AdSense />
    <script>
      function initReveal() {
        const revealEls = document.querySelectorAll('[data-reveal]');
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12 }
          );
          revealEls.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight && rect.bottom > 0) {
              el.classList.add('is-visible');
            } else {
              io.observe(el);
            }
          });
        } else {
          revealEls.forEach((el) => el.classList.add('is-visible'));
        }
      }
      document.addEventListener('astro:page-load', initReveal);
      initReveal();
    </script>
  </body>
</html>
