---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ParticleCanvas from '../components/ParticleCanvas.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title="首页">
  <section class="hero">
    <ParticleCanvas />
    <div class="hero-content">
      <span class="hero-badge">🔥 每日更新</span>
      <h1 class="hero-title">探索 GitHub 热门开源项目</h1>
      <p class="hero-subtitle">实际体验 · 深度评测 · 帮你判断是否值得使用</p>
      <a class="btn hero-cta" href="#latest">开始阅读</a>
    </div>
    <div class="hero-scroll">
      <span>向下滚动</span>
      <div class="scroll-arrow"></div>
    </div>
  </section>

  <section id="latest" class="section latest">
    <div class="container">
      <h2 class="section-title" data-reveal>最新评测</h2>
      {posts.length === 0 ? (
        <p class="empty" data-reveal>还没有文章，先运行 <code>npm run new:trending</code> 抓取 GitHub Trending 生成草稿。</p>
      ) : (
        <div class="post-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      )}
    </div>
  </section>

  <section class="section about-section">
    <div class="container">
      <h2 class="section-title" data-reveal>关于本站</h2>
      <p class="about-text" data-reveal>
        本站专注于 GitHub Trending 热门开源项目的真实评测。
        每篇文章都会包含：项目简介、快速上手、实测体验、优缺点、适用场景和同类对比。
      </p>
      <div class="tech-tags" data-reveal>
        <span class="tech-tag">GitHub</span>
        <span class="tech-tag">开源</span>
        <span class="tech-tag">评测</span>
        <span class="tech-tag">开发者工具</span>
        <span class="tech-tag">AI</span>
        <span class="tech-tag">DevOps</span>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 0 24px;
  }

  .hero-badge {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 13px;
    color: var(--color-accent);
    background: rgba(0, 180, 216, 0.1);
    border: 1px solid var(--color-border);
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: clamp(1.8rem, 5vw, 3.2rem);
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 16px;
    text-shadow: 0 2px 30px rgba(0, 180, 216, 0.3);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: var(--color-text);
    margin-bottom: 36px;
    letter-spacing: 1px;
  }

  .hero-cta {
    display: inline-block;
  }

  .hero-scroll {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    animation: bounce 2s ease-in-out infinite;
  }

  .scroll-arrow {
    width: 16px;
    height: 16px;
    border-right: 2px solid var(--color-text-muted);
    border-bottom: 2px solid var(--color-text-muted);
    transform: rotate(45deg);
    margin: 8px auto 0;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  .section {
    padding: 80px 0;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }

  .empty {
    text-align: center;
    color: var(--color-text-muted);
  }

  .about-section {
    border-top: 1px solid var(--color-border);
  }

  .about-text {
    max-width: 720px;
    margin: 0 auto 32px;
    text-align: center;
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .tech-tag {
    padding: 8px 20px;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 50px;
    font-size: 0.9rem;
    color: var(--color-text);
    transition: border-color var(--transition), box-shadow var(--transition), color var(--transition);
  }

  .tech-tag:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 15px var(--color-accent-glow);
    color: var(--color-white);
  }

  @media (max-width: 600px) {
    .section { padding: 60px 0; }
    .post-grid { grid-template-columns: 1fr; }
  }
</style>
