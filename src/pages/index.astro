---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title="首页">
  <section class="page-header" data-reveal>
    <span class="header-badge">🔥 每日更新</span>
    <h1>GitHub Trending 开源项目评测</h1>
    <p>实际体验 · 深度评测 · 帮你判断是否值得使用</p>
  </section>

  <section id="latest" class="latest">
    {posts.length === 0 ? (
      <p class="empty" data-reveal>还没有文章，先运行 <code>npm run new:trending</code> 抓取 GitHub Trending 生成草稿。</p>
    ) : (
      <div class="post-grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    )}
  </section>

  <section class="about-section">
    <h2 class="section-title" data-reveal>关于本站</h2>
    <p class="about-text" data-reveal>
      本站专注于 GitHub Trending 热门开源项目的真实评测。
      每篇文章都会包含：项目简介、快速上手、实测体验、优缺点、适用场景和同类对比。
    </p>
    <div class="tech-tags" data-reveal>
      <span class="tech-tag">GitHub</span>
      <span class="tech-tag">开源</span>
      <span class="tech-tag">评测</span>
      <span class="tech-tag">开发者工具</span>
      <span class="tech-tag">AI</span>
      <span class="tech-tag">DevOps</span>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    padding: 32px 0 24px;
  }

  .header-badge {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 13px;
    color: var(--color-accent);
    background: rgba(0, 180, 216, 0.1);
    border: 1px solid var(--color-border);
    margin-bottom: 14px;
  }

  .page-header h1 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 8px;
    text-shadow: 0 2px 30px rgba(0, 180, 216, 0.3);
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 1rem;
    letter-spacing: 1px;
  }

  .latest {
    padding: 8px 0 40px;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: 40px 0;
  }

  .about-section {
    padding: 40px 0 60px;
    border-top: 1px solid var(--color-border);
  }

  .about-text {
    max-width: 720px;
    margin: 0 auto 32px;
    text-align: center;
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.9;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .tech-tag {
    padding: 8px 20px;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 50px;
    font-size: 0.9rem;
    color: var(--color-text);
    transition: border-color var(--transition), box-shadow var(--transition), color var(--transition);
  }

  .tech-tag:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 15px var(--color-accent-glow);
    color: var(--color-white);
  }

  @media (max-width: 600px) {
    .post-grid { grid-template-columns: 1fr; }
    .page-header { padding: 20px 0 16px; }
  }
</style>
