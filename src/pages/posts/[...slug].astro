---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((post) => post.data.locale === 'en');
  return posts.map((post) => ({
    params: { slug: post.slug.replace(/^en\//, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, tags, repo, githubUrl, stars, language, image } = post.data;
---
<BaseLayout title={title} description={description} locale="en">
  <p class="back-home"><a href="/">← Back to Home</a></p>
  <article class="post-card">
    <header class="post-header">
      <p class="post-eyebrow">⚡ DevPulse News</p>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('en-US')}</time>
        {repo && <span>📦 {repo}</span>}
        {stars ? <span>⭐ {stars.toLocaleString()}</span> : null}
        {language && <span>🔤 {language}</span>}
      </div>
      {githubUrl && (
        <p><a class="github-link" href={githubUrl} target="_blank" rel="noreferrer">View on GitHub →</a></p>
      )}
      <div class="tags">
        {tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    </header>
    {image && <img class="post-cover" src={image} alt={title} />}
    <div class="post-body">
      <Content />
    </div>
    <Giscus />
  </article>
</BaseLayout>

<style>
  .back-home {
    margin-bottom: 16px;
  }
  .back-home a {
    color: var(--color-text-muted);
    font-size: 14px;
    transition: color var(--transition);
  }
  .back-home a:hover {
    color: var(--color-accent);
  }
  .post-card {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 32px;
    backdrop-filter: blur(8px);
  }
  .post-header { margin-bottom: 28px; }
  .post-eyebrow {
    font-size: 13px;
    color: var(--color-accent);
    margin-bottom: 8px;
  }
  .post-header h1 {
    font-size: 28px;
    margin: 0 0 12px;
    color: var(--color-white);
    line-height: 1.4;
  }
  .post-cover {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    margin-bottom: 24px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--color-text-muted);
    font-size: 13px;
  }
  .github-link {
    color: var(--color-accent);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .tag {
    background: rgba(0, 180, 216, 0.08);
    border: 1px solid var(--color-border);
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 12px;
    color: var(--color-text-muted);
  }
</style>
